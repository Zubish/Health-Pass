# Node 24+; production requires approved Nigerian infrastructure and PostgreSQL.
NODE_ENV=development
HEALTHPASS_ORGANIZATION_ID=development-facility
HEALTHPASS_PUBLIC_URL=http://localhost:3100
# DATABASE_URL=postgresql://... (server only, restricted non-BYPASSRLS role)
HEALTHPASS_SQLITE_PATH=.healthpass/development.sqlite

# One explicitly reviewed partner pharmacy per initial deployment.
HEALTHPASS_PHARMACY_TENANT_ID=
HEALTHPASS_PHARMACY_BRANCH_ID=
RXLEDGER_HEALTHPASS_URL=
HEALTHPASS_SERVICE_KEY_ID=healthpass-rxledger-v1
HEALTHPASS_SERVICE_SECRET=

# AI remains disabled until approved inference and matching service credentials exist.
HEALTHPASS_RAI_ENABLED=false
RAI_HEALTHPASS_URL=
RAI_HEALTHPASS_API_KEY=
HEALTHPASS_RAI_API_KEY=

# Provisioning inputs are supplied privately for one command; never commit them.
# HEALTHPASS_PROVISION_PASSWORD, HEALTHPASS_PROVISION_EMAIL,
# HEALTHPASS_PROVISION_NAME, HEALTHPASS_PROVISION_ROLE,
# HEALTHPASS_VERIFICATION_REFERENCE, HEALTHPASS_PROVISION_TOTP_SECRET,
# HEALTHPASS_PROVISION_PATIENT_ID

# Local development. The current hosted backend choice is Neon; see docs/foundation.md.
PUBLIC_APP_ORIGIN=http://localhost:3000
HEALTHPASS_API_ORIGIN=http://127.0.0.1:4100
HEALTHPASS_API_PORT=4100
# HEALTHPASS_MODE=synthetic-development (hosted development; not a clinical pilot)
# DATABASE_URL=postgresql://... (server only; never VITE_)
# HEALTHPASS_SQLITE_PATH=.data/healthpass.sqlite
# HEALTHPASS_DEMO_PASSWORD=choose-a-local-password-at-least-12-characters
# HEALTHPASS_AUTH_KEY=64-hex-characters (server only; required for production API)
# HEALTHPASS_ORIGIN_SECRET=server-only-random-secret-at-least-32-characters
# Set the same origin secret on the web server and Neon function; never use a VITE_ variable.
# Optional patient activation email delivery (private API/worker environment only).
# RESEND_API_KEY=server-only-provider-key
# HEALTHPASS_EMAIL_FROM=HealthPass <verified-sender@your-domain>
# HEALTHPASS_AUTH_KEY also encrypts queued invitation links.
